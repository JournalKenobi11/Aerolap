{% include 'html/navigation/breadcrumbs.html.twig' with {'breadcrumbs': [
    {
        'url': path('training_stress'),
        'label': 'Workload & Stress'|trans
    }]} %}

{% autoescape false %}
<div class="space-y-4">

    <!-- Page Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 pb-2 border-b border-gray-200">
        <div>
            <h1 class="text-lg font-semibold text-gray-900">
                {{ "Training Workload & Stress Analysis"|trans }}
            </h1>
            <p class="text-xs text-gray-500 mt-0.5">
                {{ "Dual-pathway physiological monitoring: Cardiovascular Strain (Internal Engine) and Musculoskeletal Tissue Impact (Mechanical Chassis)."|trans }}
            </p>
        </div>
        <div class="flex items-center gap-2 flex-wrap text-xs">
            {% if stress.targetRaceDate is not null %}
                <div class="px-2.5 py-1 rounded-md bg-blue-50 border border-blue-500 text-blue-700 font-medium">
                    <span><strong>{{ (stress.targetDistanceMeters / 1000)|round }}K Race:</strong> {{ stress.targetRaceDate }} ({{ stress.daysToRace }} days away)</span>
                </div>
            {% endif %}
            <div class="px-2.5 py-1 rounded-md bg-gray-50 border border-gray-200 text-gray-700">
                <span>HR: <strong>{{ stress.athleteRestingHr }}–{{ stress.athleteMaxHr }} bpm</strong> (HRR {{ stress.athleteMaxHr - stress.athleteRestingHr }} bpm)</span>
            </div>
            <div class="px-2.5 py-1 rounded-md bg-gray-50 border border-gray-200 text-gray-700">
                <span>Chassis: <strong>{{ stress.athleteWeightKg }} kg</strong></span>
            </div>
        </div>
    </div>

    <!-- Coach Prescription & Taper Status Card -->
    {% set statusBg = stress.statusBadge.color == 'green' ? 'border-green-300 bg-green-50' : (stress.statusBadge.color == 'blue' ? 'border-blue-500 bg-blue-50' : (stress.statusBadge.color == 'red' ? 'border-red-300 bg-red-50' : 'border-yellow-300 bg-yellow-50')) %}
    {% set pillClass = stress.statusBadge.color == 'green' ? 'bg-green-100 text-green-800 border-green-300' : (stress.statusBadge.color == 'blue' ? 'bg-blue-100 text-blue-700 border-blue-500' : (stress.statusBadge.color == 'red' ? 'bg-red-100 text-red-800 border-red-300' : 'bg-yellow-100 text-yellow-800 border-yellow-300')) %}

    <div class="p-4 bg-white border {{ statusBg }} rounded-lg shadow-xs space-y-3">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-2">
            <div class="flex items-center gap-2 flex-wrap">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold border {{ pillClass }}">
                    {{ stress.statusBadge.label }}
                </span>
                <h2 class="text-sm font-bold text-gray-900">{{ stress.guidanceHeadline }}</h2>
            </div>
            {% if stress.isTapering %}
                <div class="text-xs font-medium text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-500">
                    {{ "Race Taper Active: Volume reduction is intentional"|trans }}
                </div>
            {% elseif stress.isPostRace %}
                <div class="text-xs font-medium text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-500">
                    {{ "Post-Race Recovery Window"|trans }}
                </div>
            {% endif %}
        </div>
        <p class="text-xs text-gray-600 leading-relaxed">
            {{ stress.guidanceText }}
        </p>
        <div class="p-3 bg-white rounded border border-gray-200 space-y-1">
            <div class="text-xs font-semibold text-gray-900">{{ stress.prescriptionTitle }}</div>
            <div class="text-xs text-gray-600 leading-relaxed">{{ stress.prescriptionText }}</div>
        </div>
    </div>

    <!-- 4-Card Primary Metrics Grid (Matching Author's Training Load Pattern) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">

        <!-- Metric 1: Cardiovascular Load (ICS) -->
        <div class="flex flex-col justify-between p-4 bg-white border border-gray-200 rounded-lg shadow-xs space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <h4 class="text-sm font-semibold text-gray-900">{{ "Cardiovascular Load"|trans }}</h4>
                    <button class="hidden lg:block ml-1" data-popover-target="popover-ics" data-popover-placement="right" type="button">
                        <svg class="size-4 text-gray-400 hover:text-gray-500" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path></svg>
                    </button>
                    <div data-popover id="popover-ics" role="tooltip" class="hidden lg:block max-w-100 text-xs">
                        <div class="p-3 space-y-2">
                            <p class="font-semibold text-gray-900">{{ "Internal Cardiovascular Strain (ICS)"|trans }}</p>
                            <p class="text-gray-600">{{ "Quantifies internal oxygen delivery demand and cardiac energy flux using Morton/Banister Heart Rate Reserve TRIMP."|trans }}</p>
                            <div class="pt-1.5 border-t border-gray-100 space-y-1">
                                <div class="font-semibold text-gray-800">{{ "Reference Guidelines (Cardio ACWR):"|trans }}</div>
                                <div><span class="font-semibold text-green-600">0.85 – 1.25</span>: {{ "Optimal aerobic adaptation"|trans }}</div>
                                <div><span class="font-semibold text-blue-600">&lt; 0.85</span>: {{ "Recovery / Taper volume reduction"|trans }}</div>
                                <div><span class="font-semibold text-red-600">&gt; 1.30</span>: {{ "Sudden cardiac fatigue surge"|trans }}</div>
                            </div>
                            <p class="text-gray-500 italic text-xxs pt-1">{{ "Recovery timeline: Fast (24 to 48 hours for metabolic restoration)."|trans }}</p>
                        </div>
                    </div>
                </div>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold {{ stress.cardioAcwr > 1.3 ? 'bg-red-100 text-red-800' : (stress.cardioAcwr < 0.85 ? 'bg-blue-100 text-blue-700' : 'bg-green-100 text-green-800') }}">
                    {{ stress.cardioStatus }}
                </span>
            </div>
            <div>
                <div class="flex items-baseline gap-2">
                    <span class="text-3xl font-extrabold {{ stress.cardioAcwr > 1.3 ? 'text-red-600' : (stress.cardioAcwr < 0.85 ? 'text-blue-600' : 'text-green-600') }}">
                        {{ stress.cardioAcwr|formatNumber(2) }}
                    </span>
                    <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">{{ "Cardio ACWR"|trans }}</span>
                </div>
                <div class="text-xs text-gray-600 font-medium mt-1">
                    {{ stress.acuteIcs|formatNumber(0) }} ICS <span class="text-gray-400 font-normal">/ {{ stress.chronicBaseIcs|formatNumber(0) }} 21d base</span>
                </div>
                <div class="text-xxs text-gray-400 mt-0.5">
                    {{ "Optimal zone: 0.85 – 1.25"|trans }}
                </div>
            </div>
        </div>

        <!-- Metric 2: Structural Tissue Load (STL) -->
        <div class="flex flex-col justify-between p-4 bg-white border border-gray-200 rounded-lg shadow-xs space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <h4 class="text-sm font-semibold text-gray-900">{{ "Structural Tissue Load"|trans }}</h4>
                    <button class="hidden lg:block ml-1" data-popover-target="popover-stl" data-popover-placement="right" type="button">
                        <svg class="size-4 text-gray-400 hover:text-gray-500" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path></svg>
                    </button>
                    <div data-popover id="popover-stl" role="tooltip" class="hidden lg:block max-w-100 text-xs">
                        <div class="p-3 space-y-2">
                            <p class="font-semibold text-gray-900">{{ "Structural Tissue Load (STL)"|trans }}</p>
                            <p class="text-gray-600">{{ "Measures cumulative mechanical ground impact cycles and Achilles/patellar tendon tensile loading based on body weight (58.4 kg) and Warden & Edwards velocity power law (v^1.3)."|trans }}</p>
                            <div class="pt-1.5 border-t border-gray-100 space-y-1">
                                <div class="font-semibold text-gray-800">{{ "Reference Guidelines (Tissue ACWR):"|trans }}</div>
                                <div><span class="font-semibold text-green-600">0.80 – 1.15</span>: {{ "Optimal tissue remodeling / safe taper"|trans }}</div>
                                <div><span class="font-semibold text-yellow-600">1.15 – 1.30</span>: {{ "Caution: Monitor tendons and shins"|trans }}</div>
                                <div><span class="font-semibold text-red-600">&gt; 1.30</span>: {{ "High overuse risk: Micro-damage outpacing repair"|trans }}</div>
                            </div>
                            <p class="text-gray-500 italic text-xxs pt-1">{{ "Remodeling timeline: Slow (48 to 72 hours for tenocyte collagen synthesis; weeks for bone cortex)."|trans }}</p>
                        </div>
                    </div>
                </div>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold {{ stress.tissueAcwr > 1.25 ? 'bg-red-100 text-red-800' : (stress.tissueAcwr < 0.80 ? 'bg-blue-100 text-blue-700' : 'bg-green-100 text-green-800') }}">
                    {{ stress.tissueStatus }}
                </span>
            </div>
            <div>
                <div class="flex items-baseline gap-2">
                    <span class="text-3xl font-extrabold {{ stress.tissueAcwr > 1.25 ? 'text-red-600' : (stress.tissueAcwr < 0.80 ? 'text-blue-600' : 'text-green-600') }}">
                        {{ stress.tissueAcwr|formatNumber(2) }}
                    </span>
                    <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">{{ "Tissue ACWR"|trans }}</span>
                </div>
                <div class="text-xs text-gray-600 font-medium mt-1">
                    {{ stress.acuteStl|formatNumber(0) }} STL <span class="text-gray-400 font-normal">/ {{ stress.chronicBaseStl|formatNumber(0) }} 21d base</span>
                </div>
                <div class="text-xxs text-gray-400 mt-0.5">
                    {{ "Safe zone: 0.80 – 1.15"|trans }}
                </div>
            </div>
        </div>

        <!-- Metric 3: Engine vs. Chassis Divergence (TCDI) -->
        <div class="flex flex-col justify-between p-4 bg-white border border-gray-200 rounded-lg shadow-xs space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <h4 class="text-sm font-semibold text-gray-900">{{ "Tissue-Cardio Divergence"|trans }}</h4>
                    <button class="hidden lg:block ml-1" data-popover-target="popover-tcdi" data-popover-placement="right" type="button">
                        <svg class="size-4 text-gray-400 hover:text-gray-500" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path></svg>
                    </button>
                    <div data-popover id="popover-tcdi" role="tooltip" class="hidden lg:block max-w-100 text-xs">
                        <div class="p-3 space-y-2">
                            <p class="font-semibold text-gray-900">{{ "Tissue-to-Cardio Divergence Index (TCDI)"|trans }}</p>
                            <p class="text-gray-600">{{ "Evaluates whether mechanical ground impact (Chassis) is outpacing cardiovascular fitness (Engine). Calculated as: Tissue ACWR - Cardio ACWR."|trans }}</p>
                            <div class="pt-1.5 border-t border-gray-100 space-y-1">
                                <div class="font-semibold text-gray-800">{{ "Reference Guidelines (Divergence Index):"|trans }}</div>
                                <div><span class="font-semibold text-red-600">&gt; +0.20</span>: {{ "Chassis Overdrive (High tendon strain even if heart feels fresh)"|trans }}</div>
                                <div><span class="font-semibold text-green-600">-0.15 to +0.20</span>: {{ "Physiological Equilibrium (Engine and chassis in balance)"|trans }}</div>
                                <div><span class="font-semibold text-blue-600">&lt; -0.15</span>: {{ "Tissue-Sparing (Aerobic stimulus high while joints rest; ideal taper)"|trans }}</div>
                            </div>
                        </div>
                    </div>
                </div>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold {{ stress.divergence > 0.20 ? 'bg-red-100 text-red-800' : (stress.divergence < -0.15 ? 'bg-blue-100 text-blue-700' : 'bg-green-100 text-green-800') }}">
                    {{ stress.divergenceStatus|upper }}
                </span>
            </div>
            <div>
                <div class="flex items-baseline gap-2">
                    <span class="text-3xl font-extrabold {{ stress.divergence > 0.20 ? 'text-red-600' : (stress.divergence < -0.15 ? 'text-blue-600' : 'text-green-600') }}">
                        {{ stress.divergence >= 0 ? '+' : '' }}{{ stress.divergence|formatNumber(2) }}
                    </span>
                    <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">{{ "TCDI Index"|trans }}</span>
                </div>
                <div class="text-xs text-gray-600 font-medium mt-1 truncate">
                    {{ stress.divergenceLabel }}
                </div>
                <div class="text-xxs text-gray-400 mt-0.5">
                    {{ "Tissue ACWR (" ~ stress.tissueAcwr|formatNumber(2) ~ ") - Cardio ACWR (" ~ stress.cardioAcwr|formatNumber(2) ~ ")" }}
                </div>
            </div>
        </div>

        <!-- Metric 4: Weekly Running Volume & Long Run -->
        <div class="flex flex-col justify-between p-4 bg-white border border-gray-200 rounded-lg shadow-xs space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <h4 class="text-sm font-semibold text-gray-900">{{ "Weekly Running Distance"|trans }}</h4>
                    <button class="hidden lg:block ml-1" data-popover-target="popover-vol" data-popover-placement="right" type="button">
                        <svg class="size-4 text-gray-400 hover:text-gray-500" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path></svg>
                    </button>
                    <div data-popover id="popover-vol" role="tooltip" class="hidden lg:block max-w-100 text-xs">
                        <div class="p-3 space-y-2">
                            <p class="font-semibold text-gray-900">{{ "Weekly Mileage & Progression"|trans }}</p>
                            <p class="text-gray-600">{{ "Evaluates total running kilometers and long run step against your 21-day prior baseline."|trans }}</p>
                            <div class="pt-1.5 border-t border-gray-100 space-y-1">
                                <div class="font-semibold text-gray-800">{{ "Reference Guidelines:"|trans }}</div>
                                <div><span class="font-semibold text-green-600">&le; +10%</span>: {{ "Safe weekly progression envelope"|trans }}</div>
                                <div><span class="font-semibold text-yellow-600">+10% to +20%</span>: {{ "Watch: High volume step"|trans }}</div>
                                <div><span class="font-semibold text-blue-600">-10% to -30%</span>: {{ "Taper volume reduction zone"|trans }}</div>
                            </div>
                        </div>
                    </div>
                </div>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-gray-100 text-gray-800">
                    {{ stress.acuteRunCount }} {{ stress.acuteRunCount == 1 ? 'run' : 'runs' }}
                </span>
            </div>
            <div>
                <div class="flex items-baseline gap-2">
                    <span class="text-3xl font-extrabold text-gray-900">
                        {{ stress.acuteRunKm|formatNumber(1) }}
                    </span>
                    <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">km</span>
                </div>
                <div class="text-xs text-gray-600 font-medium mt-1 truncate">
                    {{ "Long run:"|trans }} {{ stress.longestRunKm|formatNumber(1) }} km &bull; {{ stress.volumeStepKm >= 0 ? '+' : '' }}{{ stress.volumeStepKm|formatNumber(1) }} km vs base
                </div>
                <div class="text-xxs text-gray-400 mt-0.5">
                    {{ "21d base: " ~ stress.chronicBaseRunKm|formatNumber(1) ~ " km/wk" }}
                </div>
            </div>
        </div>

    </div>

    <!-- Reference Guidelines Table (Standard Dreeve Table Styling) -->
    <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs space-y-2.5">
        <h3 class="text-xs font-bold uppercase tracking-wider text-gray-700">
            {{ "Physiological Reference Guidelines & Zones"|trans }}
        </h3>
        <div class="relative overflow-x-auto">
            <table class="data-table text-left">
                <thead>
                    <tr>
                        <th scope="col" class="text-left">{{ "Metric"|trans }}</th>
                        <th scope="col">{{ "Current Value"|trans }}</th>
                        <th scope="col">{{ "Target / Optimal Zone"|trans }}</th>
                        <th scope="col">{{ "What It Means For Your Body"|trans }}</th>
                        <th scope="col">{{ "Recovery Time"|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-left font-medium text-gray-900">{{ "Cardiovascular Load (ICS)"|trans }}</td>
                        <td class="font-semibold text-blue-600">{{ stress.acuteIcs|formatNumber(0) }} ICS (ACWR {{ stress.cardioAcwr|formatNumber(2) }})</td>
                        <td class="font-medium text-green-600">0.85 – 1.25 ACWR</td>
                        <td>Heart, lungs, blood volume, and aerobic glycogen flux (Morton/Banister HRR TRIMP).</td>
                        <td class="text-gray-500">Fast (24–48 hours)</td>
                    </tr>
                    <tr>
                        <td class="text-left font-medium text-gray-900">{{ "Structural Tissue Load (STL)"|trans }}</td>
                        <td class="font-semibold text-gray-900">{{ stress.acuteStl|formatNumber(0) }} STL (ACWR {{ stress.tissueAcwr|formatNumber(2) }})</td>
                        <td class="font-medium text-green-600">0.80 – 1.15 ACWR</td>
                        <td>Achilles/patellar tendon tensile load and bone impact cycles (Warden &amp; Edwards power law).</td>
                        <td class="text-gray-500">Slow (48–72h for collagen; weeks for bone)</td>
                    </tr>
                    <tr>
                        <td class="text-left font-medium text-gray-900">{{ "Tissue-Cardio Divergence"|trans }}</td>
                        <td class="font-semibold {{ stress.divergence > 0.20 ? 'text-red-600' : 'text-blue-600' }}">{{ stress.divergence >= 0 ? '+' : '' }}{{ stress.divergence|formatNumber(2) }} ({{ stress.divergenceLabel }})</td>
                        <td class="font-medium text-green-600">-0.15 to +0.20</td>
                        <td>Balance between mechanical pounding and cardiovascular fitness. Prevents tendon overdrive.</td>
                        <td class="text-gray-500">Continuous balance</td>
                    </tr>
                    <tr>
                        <td class="text-left font-medium text-gray-900">{{ "Weekly Running Mileage"|trans }}</td>
                        <td class="font-semibold text-gray-900">{{ stress.acuteRunKm|formatNumber(1) }} km ({{ stress.acuteRunCount }} runs)</td>
                        <td class="font-medium text-green-600">14.0 – 22.5 km/wk</td>
                        <td>Distance volume compared to your {{ stress.chronicBaseRunKm|formatNumber(1) }} km 3-week base. Currently {{ stress.volumeStepKm >= 0 ? '+' : '' }}{{ stress.volumeStepKm|formatNumber(1) }} km.</td>
                        <td class="text-gray-500">7-day rolling window</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Charts Section (Explicit 320px Height for Perfect ECharts Rendering) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <!-- Dual-Pathway Adaptation Timeline Curve -->
        <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs space-y-2">
            <div class="flex items-center justify-between">
                <h3 class="text-xs font-bold uppercase tracking-wider text-gray-700">
                    {{ "Dual-Pathway Adaptation Curve"|trans }}
                </h3>
                <span class="text-xxs text-gray-400">{{ "Last 60 Days"|trans }}</span>
            </div>
            <div class="h-80 w-full" style="height: 320px; min-height: 320px;" data-echarts-options='{{ cardioChart }}'></div>
            <div class="text-xxs text-gray-400 text-center">
                {{ "Cardiovascular Strain (blue - heart) vs. Structural Tissue Load (purple - tendons & impact) on synchronized dual-axes."|trans }}
            </div>
        </div>

        <!-- Weekly Running Distance Progression Chart -->
        <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs space-y-2">
            <div class="flex items-center justify-between">
                <h3 class="text-xs font-bold uppercase tracking-wider text-gray-700">
                    {{ "Weekly Running Volume Progression"|trans }}
                </h3>
                <span class="text-xxs text-gray-400">{{ "Last 8 Weeks"|trans }}</span>
            </div>
            <div class="h-80 w-full" style="height: 320px; min-height: 320px;" data-echarts-options='{{ volumeChart }}'></div>
            <div class="text-xxs text-gray-400 text-center">
                {{ "Runs (blue) + Walks/Hikes equivalent (gray) vs 21-day chronic baseline (amber dashed)."|trans }}
            </div>
        </div>
    </div>

    <!-- Historical Progression Table (Standard Dreeve Table Styling) -->
    <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs space-y-3">
        <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold uppercase tracking-wider text-gray-700">
                {{ "Rolling 7-Day Dual-Pathway History"|trans }}
            </h3>
            <span class="text-xxs text-gray-400">{{ "Evaluated against 21-day prior baseline"|trans }}</span>
        </div>
        <div class="relative overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col" class="text-left">{{ "Interval"|trans }}</th>
                        <th scope="col">{{ "Run Dist"|trans }}</th>
                        <th scope="col">{{ "Long Run"|trans }}</th>
                        <th scope="col">{{ "Cardio (ICS)"|trans }}</th>
                        <th scope="col">{{ "Tissue (STL)"|trans }}</th>
                        <th scope="col">{{ "Cardio ACWR"|trans }}</th>
                        <th scope="col">{{ "Tissue ACWR"|trans }}</th>
                        <th scope="col">{{ "Divergence"|trans }}</th>
                        <th scope="col">{{ "Status"|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for week in stress.historyWeeks %}
                        <tr>
                            <td class="text-left font-medium text-gray-900 whitespace-nowrap">
                                {{ week.label }}
                                {% if loop.first %}
                                    <span class="ml-1 text-xxs px-1.5 py-0.5 bg-blue-50 text-blue-700 font-semibold rounded border border-blue-200">Current 7d</span>
                                {% endif %}
                            </td>
                            <td>{{ week.runKm|formatNumber(1) }} km</td>
                            <td>{{ week.longestRunKm|formatNumber(1) }} km</td>
                            <td class="font-semibold text-blue-600">{{ week.ics|formatNumber(0) }}</td>
                            <td class="font-semibold text-gray-900">{{ week.stl|formatNumber(0) }}</td>
                            <td class="{{ week.cardioAcwr > 1.25 ? 'text-yellow-600 font-bold' : (week.cardioAcwr < 0.85 ? 'text-blue-600' : 'text-green-600') }}">{{ week.cardioAcwr|formatNumber(2) }}</td>
                            <td class="{{ week.tissueAcwr > 1.25 ? 'text-red-600 font-bold' : (week.tissueAcwr < 0.80 ? 'text-blue-600' : 'text-green-600') }}">{{ week.tissueAcwr|formatNumber(2) }}</td>
                            <td class="font-bold {{ week.divergence > 0.20 ? 'text-yellow-600' : (week.divergence < -0.15 ? 'text-blue-600' : 'text-green-600') }}">{{ week.divergence >= 0 ? '+' : '' }}{{ week.divergence|formatNumber(2) }}</td>
                            <td>
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xxs font-semibold uppercase tracking-wider {{ week.status == 'Steady' ? 'bg-green-100 text-green-800' : (week.status == 'Watch' ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800') }}">
                                    {{ week.status }}
                                </span>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" class="py-6 text-center text-gray-400">
                                {{ "No historical intervals recorded yet."|trans }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endautoescape %}

{% extends "html/admin/page/template.html.twig" %}
{% block main %}
    {% autoescape false %}
    {% set gearMaintenanceLog = gearMaintenanceLog is defined ? gearMaintenanceLog : null %}
    {% set overviewUrl = redirectUrl(relativeUrl(path('admin_manage_gear_maintenance_logs_overview'))) %}
    <div class="modal-like-form">
        <div class="w-full max-w-lg overflow-y-auto p-6 bg-white border border-gray-200 rounded-lg shadow-xl">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold">
                    {{ gearMaintenanceLog ? "Edit maintenance log"|trans({}, 'admin') : "Register maintenance"|trans({}, 'admin') }}
                </h3>
                <a href="{{ overviewUrl }}" aria-label="{{ "Close"|trans({}, 'admin') }}"
                   class="grid place-items-center size-8 rounded-lg text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-900">
                    <svg class="size-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 17.94 6M18 18 6.06 6"/>
                    </svg>
                </a>
            </div>
            <form data-dispatch-command="{{ dispatchCommand }}"
                  data-redirect="{{ overviewUrl }}"
                  class="flex flex-col gap-4">
                <div data-form-error class="form-error hidden" role="alert"></div>
                {% if gearMaintenanceLog %}
                    <input type="hidden" name="gearMaintenanceLogId" value="{{ gearMaintenanceLog.getGearMaintenanceLogId() }}">
                    <div class="grid grid-cols-2 gap-4 rounded-lg bg-gray-50 p-3 text-sm">
                        <div>
                            <span class="block text-xs font-medium text-gray-500">{{ "Gear"|trans }}</span>
                            <span class="font-medium text-gray-800">{{ gearName }}</span>
                        </div>
                        <div>
                            <span class="block text-xs font-medium text-gray-500">{{ "Component"|trans({}, 'admin') }}</span>
                            <span class="font-medium text-gray-800">{{ componentLabel }}</span>
                        </div>
                        <div>
                            <span class="block text-xs font-medium text-gray-500">{{ "Task"|trans({}, 'admin') }}</span>
                            <span class="font-medium text-gray-800">{{ taskLabel }}</span>
                        </div>
                    </div>
                    <div>
                        <label for="gml-performed-on">{{ "Performed on"|trans({}, 'admin') }}</label>
                        <input type="date" id="gml-performed-on" name="performedOn" required
                               value="{{ gearMaintenanceLog.getPerformedOn()|date('Y-m-d') }}">
                    </div>
                {% else %}
                    {% if components is empty %}
                        <div class="rounded-lg bg-gray-50 border border-gray-200 p-4 text-sm text-gray-700 flex flex-col gap-2.5">
                            <div class="flex items-center gap-2 text-primary font-semibold">
                                <svg class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                <span>{{ "No maintenance tasks configured yet."|trans({}, 'admin') }}</span>
                            </div>
                            <p class="text-xs text-gray-500 leading-relaxed">
                                {{ "To log maintenance, your gear (shoes or bikes) must have maintenance tasks configured."|trans({}, 'admin') }}
                            </p>
                            {% if gears is defined and gears|length > 0 %}
                                <div class="mt-1 flex flex-col gap-2">
                                    <span class="text-xs font-medium text-gray-700">{{ "Configure tasks directly for your shoes:"|trans({}, 'admin') }}</span>
                                    <div class="flex flex-wrap gap-2">
                                        {% for gear in gears %}
                                            <a href="{{ relativeUrl(path('admin_edit_gear', {gearId: gear.getId()})) }}"
                                               class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold bg-primary text-white hover:brightness-95 shadow-xs transition">
                                                <span>{{ gear.getName() }}</span>
                                                <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                                                </svg>
                                            </a>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    {% else %}
                        <div>
                            <label for="gml-component">{{ "Gear / Component"|trans({}, 'admin') }}</label>
                            <select id="gml-component" required>
                                <option value="" disabled selected>{{ "Select gear or component…"|trans({}, 'admin') }}</option>
                                {% for component in components %}
                                    <option value="{{ loop.index0 }}">{{ component.label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div>
                            <label for="gml-task">{{ "Task"|trans({}, 'admin') }}</label>
                            <select id="gml-task" name="maintenanceTaskId" data-depends-on="gml-component" required disabled>
                                <option value="" disabled selected>{{ "Select gear first..."|trans({}, 'admin') }}</option>
                                {% for component in components %}
                                    {% set componentIndex = loop.index0 %}
                                    {% for task in component.tasks %}
                                        <option value="{{ task.id }}" data-when="{{ componentIndex }}">{{ task.label }}</option>
                                    {% endfor %}
                                {% endfor %}
                            </select>
                        </div>
                        <div data-field class="hidden">
                            <label for="gml-gear">{{ "Gear"|trans }}</label>
                            <select id="gml-gear" name="gearId" data-depends-on="gml-component" data-collapse-single required disabled>
                                <option value="" disabled selected>{{ "Select the serviced gear…"|trans({}, 'admin') }}</option>
                                {% for component in components %}
                                    {% set componentIndex = loop.index0 %}
                                    {% for gear in component.gears %}
                                        <option value="{{ gear.id }}" data-when="{{ componentIndex }}">{{ gear.label }}</option>
                                    {% endfor %}
                                {% endfor %}
                            </select>
                            <p class="mt-1 text-xxs text-gray-500">{{ "This component is fitted to multiple gears, pick the one you serviced."|trans({}, 'admin') }}</p>
                        </div>
                        <div>
                            <label for="gml-performed-on">{{ "Performed on"|trans({}, 'admin') }}</label>
                            <input type="date" id="gml-performed-on" name="performedOn" required value="{{ "now"|date('Y-m-d') }}">
                        </div>
                    {% endif %}
                {% endif %}
                <div class="flex justify-end gap-2 border-t border-gray-200 pt-4">
                    <a href="{{ overviewUrl }}" type="button" class="btn--secondary">{{ "Cancel"|trans({}, 'admin') }}</a>
                    {% if gearMaintenanceLog or (components is defined and components|length > 0) %}
                        <button type="submit" data-has-loading-state class="group btn--primary">
                            <span class="label">{{ "Save"|trans({}, 'admin') }}</span>
                            <span class="label--loading">{{ "Saving..."|trans({}, 'admin') }}</span>
                        </button>
                    {% endif %}
                </div>
            </form>
        </div>
    </div>
    {% endautoescape %}
{% endblock main %}

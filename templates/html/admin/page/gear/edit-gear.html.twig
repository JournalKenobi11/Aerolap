{% extends "html/admin/page/template.html.twig" %}
{% block main %}
    {% autoescape false %}
    {% set gear = gear is defined ? gear : null %}
    {% set isReadOnly = gear ? gear.getType().isImported() : false %}
    <div class="modal-like-form">
        <div class="w-full max-w-2xl overflow-y-auto p-6 bg-white border border-gray-200 rounded-lg shadow-xl">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold">
                    {{ gear ? "Edit gear"|trans({}, 'admin') : "Add gear"|trans({}, 'admin') }}
                </h3>
                <a href="{{ relativeUrl(path('admin_manage_gear_overview')) }}" aria-label="{{ "Close"|trans({}, 'admin') }}"
                   class="grid place-items-center size-8 rounded-lg text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-900">
                    <svg class="size-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 17.94 6M18 18 6.06 6"/>
                    </svg>
                </a>
            </div>
            <form data-dispatch-command="{{ dispatchCommand }}" data-redirect="{{ relativeUrl(path('admin_manage_gear_overview')) }}" class="flex flex-col gap-4">
            {% if gear %}
                <input type="hidden" name="gearId" value="{{ gear.getId() }}">
            {% endif %}
            <div data-form-error class="form-error hidden" role="alert"></div>
            {% embed 'html/admin/component/strava-disabled-form-input.html.twig' with {
                isReadOnly: isReadOnly, label: 'Name'|trans,
                for: 'gear-name', name: 'name', value: gear ? gear.getOriginalName(),
            } %}
                {% block control %}
                    <input type="text" id="gear-name" name="name" required value="{{ gear ? gear.getOriginalName() }}" {{ disabled ? 'disabled' }}>
                {% endblock %}
            {% endembed %}
            <div>
                <label for="gear-purchase-price">{{ "Purchase price"|trans }}</label>
                {% set purchasePrice = gear ? gear.getPurchasePrice() : null %}
                {% set purchasePriceCurrency = purchasePrice ? purchasePrice.getCurrency().getCode() : 'EUR' %}
                <div class="mt-1 flex gap-2">
                    <input type="number" step="0.01" min="0" id="gear-purchase-price" name="purchasePriceAmount" value="{{ purchasePrice|formatMoneyDecimal }}" placeholder="0.00">
                    <select name="purchasePriceCurrency" class="w-auto">
                        {% for currency in currencies() %}
                            <option value="{{ currency }}" {{ currency == purchasePriceCurrency ? 'selected' }}>{{ currency }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            {% set currentStatus = gear ? gear.getStatus() : null %}
            {% embed 'html/admin/component/strava-disabled-form-input.html.twig' with {
                isReadOnly: isReadOnly, label: 'Status'|trans,
                for: 'gear-status', name: 'status', value: currentStatus ? currentStatus.value,
            } %}
                {% block control %}
                    <select id="gear-status" name="status" {{ disabled ? 'disabled' }}>
                        {% for status in statuses %}
                            <option value="{{ status.value }}" {{ status == currentStatus ? 'selected' }}>{{ status|trans }}</option>
                        {% endfor %}
                    </select>
                {% endblock %}
            {% endembed %}
            <div>
                <label>{{ "Image"|trans({}, 'admin') }}</label>
                {% set existingImages = [] %}
                {% if gear and gear.getLocalImagePath() %}
                    {% set path = gear.getLocalImagePath() %}
                    {% set existingImages = [{ url: path, name: path|split('/')|last, path: path }] %}
                {% endif %}
                {% include 'html/admin/component/image-dropzone-upload.html.twig' with { name: 'localImagePath', maxImages: 1, existingImages: existingImages } %}
            </div>
            {% set initialTasks = initialTasks is defined ? initialTasks : [] %}
            <div data-repeater data-repeater-min="0">
                <label>{{ "Maintenance tasks"|trans({}, 'admin') }}</label>
                <p class="mt-0.5 text-xxs text-gray-500">{{ "Define what maintenance needs doing for this gear and how often (e.g. retirement check, wash, foam inspection)."|trans({}, 'admin') }}</p>
                <div class="mt-2 flex flex-col gap-2"
                     data-repeater-list
                     data-repeater-initial="{{ initialTasks|json_encode|e('html_attr') }}">
                </div>
                <button type="button" data-repeater-add class="mt-2 inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold bg-primary-soft text-primary hover:bg-primary hover:text-white transition">
                    <svg class="size-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-7 7V5"/>
                    </svg>
                    <span>{{ "Add task"|trans({}, 'admin') }}</span>
                </button>
                <template data-repeater-template>
                    <div class="flex flex-col gap-2 sm:flex-row sm:items-center p-3 bg-gray-50 rounded-lg border border-gray-200" data-repeater-item>
                        <input type="hidden" name="maintenanceTasks[__index__][id]" data-repeater-field="id">
                        <input type="text" name="maintenanceTasks[__index__][label]"
                               data-repeater-field="label" required
                               placeholder="{{ "Task name (e.g. Retire check)"|trans({}, 'admin') }}" class="mt-0 sm:flex-1">
                        <input type="number" min="1" name="maintenanceTasks[__index__][interval][value]"
                               data-repeater-field="interval.value" required
                               placeholder="{{ "Every"|trans({}, 'admin') }}" class="mt-0 sm:w-24">
                        <select name="maintenanceTasks[__index__][interval][unit]"
                                data-repeater-field="interval.unit" class="mt-0 sm:w-44">
                            <option value="km">{{ "kilometers used"|trans({}, 'admin') }}</option>
                            <option value="mi">{{ "miles used"|trans({}, 'admin') }}</option>
                            <option value="hours">{{ "hours used"|trans({}, 'admin') }}</option>
                            <option value="days">{{ "calendar days"|trans({}, 'admin') }}</option>
                            <option value="daysUsed">{{ "active days"|trans({}, 'admin') }}</option>
                        </select>
                        <button type="button" data-repeater-remove
                                class="grid place-items-center size-9 shrink-0 self-end sm:self-auto rounded-lg border border-gray-300 bg-gray-100 text-gray-600 hover:text-red-500 hover:border-red-500 transition-colors"
                                aria-label="{{ "Remove task"|trans({}, 'admin') }}">
                            <svg class="size-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 17.94 6M18 18 6.06 6"/>
                            </svg>
                        </button>
                    </div>
                </template>
            </div>
            <div class="flex justify-end gap-2 border-t border-gray-200 pt-4">
                {% if isDeletable %}
                    <a href="{{ relativeUrl(path('admin_delete_gear', {gearId: gear.getId()})) }}" type="button" class="btn--danger me-auto">{{ "Delete"|trans({}, 'admin') }}</a>
                {% endif %}
                <a href="{{ relativeUrl(path('admin_manage_gear_overview')) }}" type="button" class="btn--secondary">{{ "Cancel"|trans({}, 'admin') }}</a>
                <button type="submit" data-has-loading-state class="group btn--primary">
                    <span class="label">{{ "Save"|trans({}, 'admin') }}</span>
                    <span class="label--loading">{{ "Saving..."|trans({}, 'admin') }}</span>
                </button>
            </div>
        </form>
        </div>
    </div>
    {% endautoescape %}
{% endblock main %}

{% include 'html/navigation/breadcrumbs.html.twig' with {'breadcrumbs': [
    {
        'url': 'monthly-stats',
        'label': 'Monthly stats'|trans
    },
    {
        'url': 'monthly-stats/' ~ calendar.getMonth().getId(),
        'label': calendar.getMonth().getLabel()
    }]} %}
{% autoescape false %}
    <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs space-y-4">
        <div class="mb-4 flex items-center justify-between">
            <h1 class="flex items-center text-lg font-semibold text-gray-900">
            {% set previousMonth = calendar.getMonth().getPreviousMonth() %}
            {% set nextMonth = calendar.getMonth().getNextMonth() %}
            {% if hasPreviousMonth %}
                <a href="{{ relativeUrl(path('monthly_stats_month', {'month': previousMonth.getId()})) }}">
                    <svg class="size-3 text-gray-800" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 8 14">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 1 1.3 6.326a.91.91 0 0 0 0 1.348L7 13"/>
                    </svg>
                </a>
            {% endif %}
            <span class="mx-2">{{ calendar.getMonth().getLabel() }}</span>
            {% if hasNextMonth %}
                <a href="{{ relativeUrl(path('monthly_stats_month', {'month': nextMonth.getId()})) }}">
                    <svg class="size-3 text-gray-800" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 8 14">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 13 5.7-5.326a.909.909 0 0 0 0-1.348L1 1"/>
                    </svg>
                </a>
            {% endif %}
            </h1>
            <ul class="hidden md:flex text-center divide-x divide-gray-200">
                <li class="flex flex-col pr-2 text-sm">
                    {% if statistics.distance %}
                        <div>{{ statistics.distance|formatMeasurement(0) }}</div>
                        <div class="text-xs text-gray-500">{{ statistics.distance|convertMeasurement.getSymbol() }}</div>
                    {% else %}
                        0
                    {% endif %}
                </li>
                <li class="flex flex-col px-2 text-sm">
                    {% if statistics.elevation %}
                        <div>{{ statistics.elevation|formatMeasurement(0) }}</div>
                        <div class="text-xs text-gray-500">{{ statistics.elevation|convertMeasurement.getSymbol() }} {{ "Elev."|trans|lower }}</div>
                    {% else %}
                        0
                    {% endif %}
                </li>
                <li class="flex flex-col px-2 text-sm">
                    <div>{{ (statistics.movingTime.toHour().toFloat())|formatNumber(0) }}</div>
                    <div class="text-xs text-gray-500">{{ "hours"|trans }}</div>
                </li>
                <li class="flex flex-col px-2 text-sm">
                    <div>{{ statistics.calories|formatNumber(0) }}</div>
                    <div class="text-xs text-gray-500">kcal</div>
                </li>
                <li class="flex flex-col pl-2 text-sm">
                    <div>{{ statistics.numberOfActivities }}</div>
                    <div class="text-xs text-gray-500">{{ "workouts"|trans }}</div>
                </li>
            </ul>
        </div>

        {% if heartRateZones and heartRateZones.totalTimeInSeconds > 0 %}
            <div class="p-4 bg-gray-50 border border-gray-200 rounded-lg space-y-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="text-rose-500 font-bold">💓</span>
                        <h2 class="text-xs font-bold uppercase tracking-wider text-gray-700">
                            {{ "Monthly Run Heart Rate Zones"|trans }}
                        </h2>
                    </div>
                    <span class="text-xxs font-medium text-gray-500">
                        {{ (heartRateZones.totalTimeInSeconds / 3600)|formatNumber(1) }}h ({{ (heartRateZones.totalTimeInSeconds / 60)|formatNumber(0) }}m) tracked running time with heart rate
                    </span>
                </div>

                <!-- Full Width Segmented Level Bar -->
                <div class="w-full h-4 bg-gray-200 rounded-full overflow-hidden flex shadow-inner"
                     title="Z1: {{ heartRateZones.getPercentageInZoneOne() }}%, Z2: {{ heartRateZones.getPercentageInZoneTwo() }}%, Z3: {{ heartRateZones.getPercentageInZoneThree() }}%, Z4: {{ heartRateZones.getPercentageInZoneFour() }}%, Z5: {{ heartRateZones.getPercentageInZoneFive() }}%">
                    {% if heartRateZones.getPercentageInZoneOne() > 0 %}
                        <div class="h-full bg-[#DF584A] flex items-center justify-center text-white text-xxs font-bold" style="width: {{ heartRateZones.getPercentageInZoneOne() }}%">
                            {% if heartRateZones.getPercentageInZoneOne() >= 7 %}Z1{% endif %}
                        </div>
                    {% endif %}
                    {% if heartRateZones.getPercentageInZoneTwo() > 0 %}
                        <div class="h-full bg-[#D63522] flex items-center justify-center text-white text-xxs font-bold" style="width: {{ heartRateZones.getPercentageInZoneTwo() }}%">
                            {% if heartRateZones.getPercentageInZoneTwo() >= 7 %}Z2{% endif %}
                        </div>
                    {% endif %}
                    {% if heartRateZones.getPercentageInZoneThree() > 0 %}
                        <div class="h-full bg-[#BD2D22] flex items-center justify-center text-white text-xxs font-bold" style="width: {{ heartRateZones.getPercentageInZoneThree() }}%">
                            {% if heartRateZones.getPercentageInZoneThree() >= 7 %}Z3{% endif %}
                        </div>
                    {% endif %}
                    {% if heartRateZones.getPercentageInZoneFour() > 0 %}
                        <div class="h-full bg-[#942319] flex items-center justify-center text-white text-xxs font-bold" style="width: {{ heartRateZones.getPercentageInZoneFour() }}%">
                            {% if heartRateZones.getPercentageInZoneFour() >= 7 %}Z4{% endif %}
                        </div>
                    {% endif %}
                    {% if heartRateZones.getPercentageInZoneFive() > 0 %}
                        <div class="h-full bg-[#6A1009] flex items-center justify-center text-white text-xxs font-bold" style="width: {{ heartRateZones.getPercentageInZoneFive() }}%">
                            {% if heartRateZones.getPercentageInZoneFive() >= 7 %}Z5{% endif %}
                        </div>
                    {% endif %}
                </div>

                <!-- 5-Zone Cards Breakdown Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-5 gap-2 text-center text-xs">
                    <div class="p-2.5 bg-white rounded border border-gray-200 shadow-2xs">
                        <div class="flex items-center justify-center gap-1.5 text-xxs font-bold uppercase text-gray-700">
                            <span class="size-2 rounded-full bg-[#DF584A] inline-block"></span> Zone 1
                        </div>
                        <div class="text-base font-extrabold mt-0.5" style="color: #DF584A">
                            {{ heartRateZones.getPercentageInZoneOne() }}%
                        </div>
                        <div class="text-xxs text-gray-400">
                            {{ (heartRateZones.timeInZoneOne / 60)|formatNumber(0) }}m
                        </div>
                    </div>

                    <div class="p-2.5 bg-white rounded border border-gray-200 shadow-2xs">
                        <div class="flex items-center justify-center gap-1.5 text-xxs font-bold uppercase text-gray-700">
                            <span class="size-2 rounded-full bg-[#D63522] inline-block"></span> Zone 2
                        </div>
                        <div class="text-base font-extrabold mt-0.5" style="color: #D63522">
                            {{ heartRateZones.getPercentageInZoneTwo() }}%
                        </div>
                        <div class="text-xxs text-gray-400">
                            {{ (heartRateZones.timeInZoneTwo / 60)|formatNumber(0) }}m
                        </div>
                    </div>

                    <div class="p-2.5 bg-white rounded border border-gray-200 shadow-2xs">
                        <div class="flex items-center justify-center gap-1.5 text-xxs font-bold uppercase text-gray-700">
                            <span class="size-2 rounded-full bg-[#BD2D22] inline-block"></span> Zone 3
                        </div>
                        <div class="text-base font-extrabold mt-0.5" style="color: #BD2D22">
                            {{ heartRateZones.getPercentageInZoneThree() }}%
                        </div>
                        <div class="text-xxs text-gray-400">
                            {{ (heartRateZones.timeInZoneThree / 60)|formatNumber(0) }}m
                        </div>
                    </div>

                    <div class="p-2.5 bg-white rounded border border-gray-200 shadow-2xs">
                        <div class="flex items-center justify-center gap-1.5 text-xxs font-bold uppercase text-gray-700">
                            <span class="size-2 rounded-full bg-[#942319] inline-block"></span> Zone 4
                        </div>
                        <div class="text-base font-extrabold mt-0.5" style="color: #942319">
                            {{ heartRateZones.getPercentageInZoneFour() }}%
                        </div>
                        <div class="text-xxs text-gray-400">
                            {{ (heartRateZones.timeInZoneFour / 60)|formatNumber(0) }}m
                        </div>
                    </div>

                    <div class="p-2.5 bg-white rounded border border-gray-200 shadow-2xs">
                        <div class="flex items-center justify-center gap-1.5 text-xxs font-bold uppercase text-gray-700">
                            <span class="size-2 rounded-full bg-[#6A1009] inline-block"></span> Zone 5
                        </div>
                        <div class="text-base font-extrabold mt-0.5" style="color: #6A1009">
                            {{ heartRateZones.getPercentageInZoneFive() }}%
                        </div>
                        <div class="text-xxs text-gray-400">
                            {{ (heartRateZones.timeInZoneFive / 60)|formatNumber(0) }}m
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        <div class="grid grid-cols-1 gap-4">
            <div class="flex flex-col">
                <div class="grid grid-cols-7 gap-px leading-6 font-semibold text-xs text-center border border-b-0">
                    <div class="py-2 bg-white">
                        {{ "Mon"|trans }}
                    </div>
                    <div class="py-2 bg-white">
                        {{ "Tue"|trans }}
                    </div>
                    <div class="py-2 bg-white">
                        {{ "Wed"|trans }}
                    </div>
                    <div class="py-2 bg-white">
                        {{ "Thu"|trans }}
                    </div>
                    <div class="py-2 bg-white">
                        {{ "Fri"|trans }}
                    </div>
                    <div class="py-2 bg-white">
                        {{ "Sat"|trans }}
                    </div>
                    <div class="py-2 bg-white">
                        {{ "Sun"|trans }}
                    </div>
                </div>
                <div class="grid grid-cols-7 gap-px leading-6 text-xs w-full bg-gray-200 border">
                    {#
                    class="bg-emerald-600/10 border-l-emerald-600"
                    class="bg-sky-500/10 border-l-sky-500"
                    class="bg-primary/10 border-l-primary"
                    class="bg-yellow-300/10 border-l-yellow-300"
                    class="bg-blue-600/10 border-l-blue-600"
                    class="bg-red-600/10 border-l-red-600"
                    class="bg-gray-600/10 border-l-gray-600"
                    #}
                    {% for day in calendar.getDays() %}
                        <div class="py-2 px-3 {{ day.isCurrentMonth ? 'bg-white' : 'bg-gray-100' }}">
                            <div class="text-right text-gray-400">
                                {{ day.getDayNumber() }}
                            </div>
                            <div class="h-16 overflow-y-auto">
                                {% if not day.getActivities().isEmpty() %}
                                    <ul>
                                        {% for activity in day.getActivities() %}
                                            {% set color = activity.getSportType().getActivityType().getColor() %}
                                            {% set distance = activity.getDistanceInDisplayUnit() %}
                                            <li class="mb-1 truncate pl-1 bg-{{ color }}/[.1] border-l-2 border-l-{{ color }}" title="{{ activity.getName()|e }}&#10;{{ activity.getMovingTimeFormatted() }}{% if distance.toFloat() > 0 %} · {{ distance|formatMeasurement(activity.getSportType().getDistancePrecision()) }} {{ distance|measurementSymbol }}{% endif %}">
                                                {{ activity|activityLink(truncate: true) }}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endautoescape %}
{% include 'html/navigation/breadcrumbs.html.twig' with {'breadcrumbs': [{
    'url': 'monthly-stats',
    'label': 'Monthly stats'|trans
}]} %}
 {% set totals = monthlyStatistics.getTotals() %}
{% autoescape false %}
    <!-- MONTHLY STATS -->
    <div class="grid grid-cols-1 mb-4">
        <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
            <div class="relative overflow-x-auto">
                <table id="table-months" class="data-table" data-accordion="table-months"
                       data-active-classes="text-gray-500" data-inactive-classes="text-gray-500">
                    <thead>
                    <tr class="group/row">
                        <th class="narrow"></th>
                        <th scope="col" class="narrow sticky left-0 bg-gray-50">
    
                        </th>
                        <th scope="col" class="narrow">
                            # {{ "workouts"|trans }}
                        </th>
                        <th scope="col">
                            {{ "Dist."|trans }}
                        </th>
                        <th scope="col">
                            {{ "Elev."|trans }}
                        </th>
                        <th scope="col">
                            {{ "Moving time"|trans }}
                        </th>
                        <th scope="col">
                            {{ "Cal."|trans }}
                        </th>
                        <th scope="col" class="min-w-52">
                            {{ "Run HR Zones"|trans }}
                        </th>
                    </tr>
                    </thead>
                    {% for month in months %}
                        {% set statsForCurrentMonth = monthlyStatistics.getForMonth(month) %}
                        {% if statsForCurrentMonth|length > 0 %}
                            <tbody>
                            <tr class="group/row cursor-pointer"
                                id="table-months-header-{{ loop.index0 }}"
                                data-accordion-target="#table-months-content-{{ loop.index0 }}"
                                aria-expanded="false" aria-controls="table-months-content-{{ loop.index0 }}">
                                <td class="w-4 text-gray-700">
                                    <svg data-accordion-icon class="size-2 rotate-180 shrink-0" aria-hidden="true"
                                         xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                              stroke-width="2"
                                              d="M9 5 5 1 1 5"/>
                                    </svg>
                                </td>
                                <th scope="row"
                                    class="bg-white sticky left-0 text-right font-medium whitespace-nowrap">
                                    <a href="{{ relativeUrl(path('monthly_stats_month', {'month': month.getId()})) }}"
                                       class="text-blue-600 hover:underline">
                                        {{ month.getLabel() }}
                                    </a>
                                </th>
                                <td class="truncate">
                                    {{ statsForCurrentMonth.numberOfActivities }}
                                </td>
                                <td class="truncate">
                                    {{ statsForCurrentMonth.distance|renderMeasurement(0) }}
                                </td>
                                <td class="truncate">
                                    {{ statsForCurrentMonth.elevation|renderMeasurement(0) }}
                                </td>
                                <td class="truncate" title="{{ statsForCurrentMonth.movingTime.toHour().toFloat()|formatNumber(1) }}h">
                                    {{ statsForCurrentMonth.movingTime|formatSeconds }}
                                </td>
                                <td class="truncate">
                                    {{ statsForCurrentMonth.calories|formatNumber(0) }}<span class="text-xxs ml-px">kcal</span>
                                </td>
                                <td class="w-60 py-2 px-3">
                                    {% set hrZoneTotals = heartRateZonesPerMonth[month.getId()] ?? null %}
                                    {% if hrZoneTotals and hrZoneTotals.totalTimeInSeconds > 0 %}
                                        <div class="space-y-1">
                                            <div class="flex items-center gap-2">
                                                <div class="grow h-3 bg-gray-200 rounded-full overflow-hidden flex shadow-inner"
                                                     title="Z1: {{ hrZoneTotals.getPercentageInZoneOne() }}%, Z2: {{ hrZoneTotals.getPercentageInZoneTwo() }}%, Z3: {{ hrZoneTotals.getPercentageInZoneThree() }}%, Z4: {{ hrZoneTotals.getPercentageInZoneFour() }}%, Z5: {{ hrZoneTotals.getPercentageInZoneFive() }}%">
                                                    {% if hrZoneTotals.getPercentageInZoneOne() > 0 %}
                                                        <div class="h-full bg-[#DF584A]" style="width: {{ hrZoneTotals.getPercentageInZoneOne() }}%"></div>
                                                    {% endif %}
                                                    {% if hrZoneTotals.getPercentageInZoneTwo() > 0 %}
                                                        <div class="h-full bg-[#D63522]" style="width: {{ hrZoneTotals.getPercentageInZoneTwo() }}%"></div>
                                                    {% endif %}
                                                    {% if hrZoneTotals.getPercentageInZoneThree() > 0 %}
                                                        <div class="h-full bg-[#BD2D22]" style="width: {{ hrZoneTotals.getPercentageInZoneThree() }}%"></div>
                                                    {% endif %}
                                                    {% if hrZoneTotals.getPercentageInZoneFour() > 0 %}
                                                        <div class="h-full bg-[#942319]" style="width: {{ hrZoneTotals.getPercentageInZoneFour() }}%"></div>
                                                    {% endif %}
                                                    {% if hrZoneTotals.getPercentageInZoneFive() > 0 %}
                                                        <div class="h-full bg-[#6A1009]" style="width: {{ hrZoneTotals.getPercentageInZoneFive() }}%"></div>
                                                    {% endif %}
                                                </div>
                                                <span class="text-xxs text-gray-500 font-medium shrink-0">
                                                    {{ (hrZoneTotals.totalTimeInSeconds / 60)|formatNumber(0) }}m
                                                </span>
                                            </div>
                                            <div class="flex items-center justify-between text-xxs font-mono text-gray-400 leading-none">
                                                <span class="{{ hrZoneTotals.getPercentageInZoneOne() > 0 ? 'font-semibold' : 'text-gray-300' }}" {% if hrZoneTotals.getPercentageInZoneOne() > 0 %}style="color: #DF584A"{% endif %}>Z1 {{ hrZoneTotals.getPercentageInZoneOne() }}%</span>
                                                <span class="{{ hrZoneTotals.getPercentageInZoneTwo() > 0 ? 'font-semibold' : 'text-gray-300' }}" {% if hrZoneTotals.getPercentageInZoneTwo() > 0 %}style="color: #D63522"{% endif %}>Z2 {{ hrZoneTotals.getPercentageInZoneTwo() }}%</span>
                                                <span class="{{ hrZoneTotals.getPercentageInZoneThree() > 0 ? 'font-semibold' : 'text-gray-300' }}" {% if hrZoneTotals.getPercentageInZoneThree() > 0 %}style="color: #BD2D22"{% endif %}>Z3 {{ hrZoneTotals.getPercentageInZoneThree() }}%</span>
                                                <span class="{{ hrZoneTotals.getPercentageInZoneFour() > 0 ? 'font-semibold' : 'text-gray-300' }}" {% if hrZoneTotals.getPercentageInZoneFour() > 0 %}style="color: #942319"{% endif %}>Z4 {{ hrZoneTotals.getPercentageInZoneFour() }}%</span>
                                                <span class="{{ hrZoneTotals.getPercentageInZoneFive() > 0 ? 'font-semibold' : 'text-gray-300' }}" {% if hrZoneTotals.getPercentageInZoneFive() > 0 %}style="color: #6A1009"{% endif %}>Z5 {{ hrZoneTotals.getPercentageInZoneFive() }}%</span>
                                            </div>
                                        </div>
                                    {% else %}
                                        <span class="text-gray-300 text-xxs italic">—</span>
                                    {% endif %}
                                </td>
                            </tr>
                            </tbody>
                            <tbody class="hidden border-b"
                                   id="table-months-content-{{ loop.index0 }}"
                                   aria-labelledby="table-months-header-{{ loop.index0 }}">
                            {% for sportType in sportTypes %}
                                {% set totalsForSportType = monthlyStatistics.getForMonthAndSportType(month, sportType) %}
                                {% if totalsForSportType.numberOfActivities > 0 %}
                                    <tr>
                                        <td class="w-4 p-2">
    
                                        </td>
                                        <td class="text-gray-700 bg-white sticky left-0 text-right font-medium whitespace-nowrap">
                                            {{ sportType|trans }}
                                        </td>
                                        <td class="truncate">
                                            {{ totalsForSportType.numberOfActivities }}
                                        </td>
                                        <td class="truncate">
                                            {{ totalsForSportType.distance|renderMeasurement(0) }}
                                        </td>
                                        <td class="truncate">
                                            {{ totalsForSportType.elevation|renderMeasurement(0) }}
                                        </td>
                                        <td class="truncate" title="{{ totalsForSportType.movingTime.toHour().toFloat()|formatNumber(1) }}h">
                                            {{ totalsForSportType.movingTime|formatSeconds }}
                                        </td>
                                        <td class="truncate">
                                            {{ totalsForSportType.calories|formatNumber(0) }}<span class="text-xxs ml-px">kcal</span>
                                        </td>
                                        <td class="w-60 py-2 px-3">
                                            {% if sportType.value == 'Run' or sportType.getActivityType().value == 'run' %}
                                                {% set sportHrZoneTotals = heartRateZonesPerMonthAndSportType[month.getId()][sportType.value] ?? null %}
                                                {% if sportHrZoneTotals and sportHrZoneTotals.totalTimeInSeconds > 0 %}
                                                    <div class="space-y-1">
                                                        <div class="flex items-center gap-2">
                                                            <div class="grow h-2 bg-gray-200 rounded-full overflow-hidden flex shadow-inner"
                                                                 title="Z1: {{ sportHrZoneTotals.getPercentageInZoneOne() }}%, Z2: {{ sportHrZoneTotals.getPercentageInZoneTwo() }}%, Z3: {{ sportHrZoneTotals.getPercentageInZoneThree() }}%, Z4: {{ sportHrZoneTotals.getPercentageInZoneFour() }}%, Z5: {{ sportHrZoneTotals.getPercentageInZoneFive() }}%">
                                                                {% if sportHrZoneTotals.getPercentageInZoneOne() > 0 %}
                                                                    <div class="h-full bg-[#DF584A]" style="width: {{ sportHrZoneTotals.getPercentageInZoneOne() }}%"></div>
                                                                {% endif %}
                                                                {% if sportHrZoneTotals.getPercentageInZoneTwo() > 0 %}
                                                                    <div class="h-full bg-[#D63522]" style="width: {{ sportHrZoneTotals.getPercentageInZoneTwo() }}%"></div>
                                                                {% endif %}
                                                                {% if sportHrZoneTotals.getPercentageInZoneThree() > 0 %}
                                                                    <div class="h-full bg-[#BD2D22]" style="width: {{ sportHrZoneTotals.getPercentageInZoneThree() }}%"></div>
                                                                {% endif %}
                                                                {% if sportHrZoneTotals.getPercentageInZoneFour() > 0 %}
                                                                    <div class="h-full bg-[#942319]" style="width: {{ sportHrZoneTotals.getPercentageInZoneFour() }}%"></div>
                                                                {% endif %}
                                                                {% if sportHrZoneTotals.getPercentageInZoneFive() > 0 %}
                                                                    <div class="h-full bg-[#6A1009]" style="width: {{ sportHrZoneTotals.getPercentageInZoneFive() }}%"></div>
                                                                {% endif %}
                                                            </div>
                                                            <span class="text-xxs text-gray-500 shrink-0">
                                                                {{ (sportHrZoneTotals.totalTimeInSeconds / 60)|formatNumber(0) }}m
                                                            </span>
                                                        </div>
                                                        <div class="flex items-center justify-between text-xxs font-mono text-gray-400 leading-none">
                                                            <span class="{{ sportHrZoneTotals.getPercentageInZoneOne() > 0 ? 'font-semibold' : 'text-gray-300' }}" {% if sportHrZoneTotals.getPercentageInZoneOne() > 0 %}style="color: #DF584A"{% endif %}>Z1 {{ sportHrZoneTotals.getPercentageInZoneOne() }}%</span>
                                                            <span class="{{ sportHrZoneTotals.getPercentageInZoneTwo() > 0 ? 'font-semibold' : 'text-gray-300' }}" {% if sportHrZoneTotals.getPercentageInZoneTwo() > 0 %}style="color: #D63522"{% endif %}>Z2 {{ sportHrZoneTotals.getPercentageInZoneTwo() }}%</span>
                                                            <span class="{{ sportHrZoneTotals.getPercentageInZoneThree() > 0 ? 'font-semibold' : 'text-gray-300' }}" {% if sportHrZoneTotals.getPercentageInZoneThree() > 0 %}style="color: #BD2D22"{% endif %}>Z3 {{ sportHrZoneTotals.getPercentageInZoneThree() }}%</span>
                                                            <span class="{{ sportHrZoneTotals.getPercentageInZoneFour() > 0 ? 'font-semibold' : 'text-gray-300' }}" {% if sportHrZoneTotals.getPercentageInZoneFour() > 0 %}style="color: #942319"{% endif %}>Z4 {{ sportHrZoneTotals.getPercentageInZoneFour() }}%</span>
                                                            <span class="{{ sportHrZoneTotals.getPercentageInZoneFive() > 0 ? 'font-semibold' : 'text-gray-300' }}" {% if sportHrZoneTotals.getPercentageInZoneFive() > 0 %}style="color: #6A1009"{% endif %}>Z5 {{ sportHrZoneTotals.getPercentageInZoneFive() }}%</span>
                                                        </div>
                                                    </div>
                                                {% else %}
                                                    <span class="text-gray-300 text-xxs italic">—</span>
                                                {% endif %}
                                            {% else %}
                                                <span class="text-gray-300 text-xxs italic">—</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endif %}
                            {% endfor %}
                            </tbody>
                        {% endif %}
                    {% endfor %}
                </table>
            </div>
        </div>
    </div>
{% endautoescape %}
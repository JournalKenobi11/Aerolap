{% autoescape false %}
    <div class="flex items-center justify-between mb-3">
        <h3 class="text-lg font-semibold">{{ widgetTitle|e }}</h3>
        <a href="{{ relativeUrl(path('training_stress')) }}"
           class="shrink-0 inline-flex items-center p-1.5 text-xs font-medium rounded-lg text-blue-600 hover:bg-gray-100">
            {{ "View details"|trans }} &rarr;
        </a>
    </div>

    <!-- Master Status Badge & Headline -->
    <div class="mb-3 p-3 rounded-lg border flex items-center justify-between {{ stress.statusBadge.color == 'green' ? 'bg-green-50 border-green-200 text-green-900' : (stress.statusBadge.color == 'blue' ? 'bg-blue-50 border-blue-200 text-blue-900' : (stress.statusBadge.color == 'red' ? 'bg-red-50 border-red-200 text-red-900' : 'bg-yellow-50 border-yellow-200 text-yellow-900')) }}">
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold uppercase tracking-wider {{ stress.statusBadge.color == 'green' ? 'bg-green-100 text-green-800' : (stress.statusBadge.color == 'blue' ? 'bg-blue-100 text-blue-800' : (stress.statusBadge.color == 'red' ? 'bg-red-100 text-red-800' : 'bg-yellow-100 text-yellow-800')) }}">
                {{ stress.statusBadge.label }}
            </span>
            <span class="text-xs font-medium truncate max-w-[200px]" title="{{ stress.guidanceHeadline }}">{{ stress.guidanceHeadline }}</span>
        </div>
        {% if stress.daysToRace is not null %}
            <span class="text-xxs px-2 py-0.5 bg-blue-50 text-blue-700 rounded font-semibold border border-blue-200 shrink-0">
                10K in {{ stress.daysToRace }}d
            </span>
        {% endif %}
    </div>

    <!-- Dual-Pathway Load Grid -->
    <div class="grid grid-cols-2 gap-2 text-center">
        <!-- Cardiovascular Strain (ICS) -->
        <div class="p-2.5 bg-white border border-gray-200 rounded-lg">
            <div class="text-xxs uppercase tracking-wider text-gray-500 font-semibold mb-1">{{ "Cardio Strain"|trans }}</div>
            <div class="text-xl font-extrabold {{ stress.cardioAcwr > 1.3 ? 'text-red-600' : (stress.cardioAcwr < 0.85 ? 'text-blue-600' : 'text-green-600') }}">
                {{ stress.cardioAcwr|formatNumber(2) }} <span class="text-xs font-normal text-gray-400">ACWR</span>
            </div>
            <div class="text-xxs text-gray-500 mt-1">
                {{ stress.acuteIcs|formatNumber(0) }} ICS <span class="text-gray-400">/ {{ stress.chronicBaseIcs|formatNumber(0) }} base</span>
            </div>
            <div class="text-xxs font-medium mt-0.5 {{ stress.cardioAcwr > 1.3 ? 'text-red-600' : 'text-green-600' }}">
                {{ stress.cardioStatus }}
            </div>
        </div>

        <!-- Structural Tissue Load (STL) -->
        <div class="p-2.5 bg-white border border-gray-200 rounded-lg">
            <div class="text-xxs uppercase tracking-wider text-gray-500 font-semibold mb-1">{{ "Tissue Load"|trans }}</div>
            <div class="text-xl font-extrabold {{ stress.tissueAcwr > 1.25 ? 'text-red-600' : (stress.tissueAcwr < 0.80 ? 'text-blue-600' : 'text-green-600') }}">
                {{ stress.tissueAcwr|formatNumber(2) }} <span class="text-xs font-normal text-gray-400">ACWR</span>
            </div>
            <div class="text-xxs text-gray-500 mt-1">
                {{ stress.acuteStl|formatNumber(0) }} STL <span class="text-gray-400">/ {{ stress.chronicBaseStl|formatNumber(0) }} base</span>
            </div>
            <div class="text-xxs font-medium mt-0.5 {{ stress.tissueAcwr > 1.25 ? 'text-red-600' : 'text-green-600' }}">
                {{ stress.tissueStatus }}
            </div>
        </div>
    </div>

    <!-- Divergence & Mileage Summary Footer -->
    <div class="mt-2.5 pt-2 border-t border-gray-100 flex items-center justify-between text-xxs text-gray-500 px-1">
        <span>TCDI: <strong class="font-bold {{ stress.divergence > 0.20 ? 'text-red-600' : 'text-blue-600' }}">{{ stress.divergence >= 0 ? '+' : '' }}{{ stress.divergence|formatNumber(2) }}</strong> ({{ stress.divergenceStatus }})</span>
        <span>Run Dist: <strong class="text-gray-900 font-semibold">{{ stress.acuteRunKm|formatNumber(1) }} km</strong> (Long: {{ stress.longestRunKm|formatNumber(1) }} km)</span>
    </div>
{% endautoescape %}

{% autoescape false %}
    <div class="flex items-center justify-between mb-3">
        <h3 class="text-lg font-semibold"> {{ widgetTitle|e }}</h3>
        <a href="{{ relativeUrl(path('training_stress')) }}"
           class="shrink-0 inline-flex items-center p-1.5 text-xs font-medium rounded-lg text-blue-600 hover:bg-gray-100">
            {{ "View details"|trans }} &rarr;
        </a>
    </div>

    <!-- Master Status Badge & Headline -->
    <div class="mb-3 p-3 rounded-lg border flex items-center justify-between {{ stress.statusBadge.color == 'green' ? 'bg-emerald-50 border-emerald-200 text-emerald-900' : (stress.statusBadge.color == 'blue' ? 'bg-blue-50 border-blue-200 text-blue-900' : (stress.statusBadge.color == 'red' ? 'bg-rose-50 border-rose-200 text-rose-900' : (stress.statusBadge.color == 'yellow' ? 'bg-amber-50 border-amber-200 text-amber-900' : 'bg-gray-50 border-gray-200 text-gray-900'))) }}">
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold uppercase tracking-wider {{ stress.statusBadge.color == 'green' ? 'bg-emerald-200 text-emerald-800' : (stress.statusBadge.color == 'blue' ? 'bg-blue-200 text-blue-800' : (stress.statusBadge.color == 'red' ? 'bg-rose-200 text-rose-800' : (stress.statusBadge.color == 'yellow' ? 'bg-amber-200 text-amber-800' : 'bg-gray-200 text-gray-800'))) }}">
                {{ stress.statusBadge.label }}
            </span>
            <span class="text-xs font-medium truncate max-w-[180px]" title="{{ stress.guidanceHeadline }}">{{ stress.guidanceHeadline }}</span>
        </div>
        {% if stress.daysToRace is not null %}
            <span class="text-xxs px-1.5 py-0.5 bg-blue-100 text-blue-700 rounded font-semibold shrink-0">
                10K in {{ stress.daysToRace }}d
            </span>
        {% endif %}
    </div>

    <!-- Dual Lens Snapshot Grid -->
    <div class="grid grid-cols-2 gap-2 text-center">
        <!-- Mechanical Lane -->
        <div class="p-2.5 bg-slate-50 border border-slate-200 rounded-lg">
            <div class="text-xxs uppercase tracking-wider text-gray-500 font-semibold mb-1">{{ "Mechanical Load"|trans }}</div>
            <div class="text-xl font-extrabold text-slate-800">
                {{ stress.acuteRunKm|formatNumber(1) }} <span class="text-xs font-normal text-gray-500">km</span>
            </div>
            <div class="text-xxs text-gray-500 mt-1">
                Step: <span class="font-bold {{ stress.volumeStepStatus == 'Safe' ? 'text-emerald-600' : (stress.volumeStepStatus == 'Watch' ? 'text-amber-600' : 'text-rose-600') }}">
                    {{ stress.volumeStepKm >= 0 ? '+' : '' }}{{ stress.volumeStepKm|formatNumber(1) }} km
                </span>
                <span class="text-gray-400">/ 21d base {{ stress.chronicBaseRunKm|formatNumber(1) }}</span>
            </div>
            <div class="text-xxs text-gray-400 mt-0.5">
                Eff: {{ stress.acuteEffectiveKm|formatNumber(1) }} km
            </div>
        </div>

        <!-- Cardio Lane -->
        <div class="p-2.5 bg-slate-50 border border-slate-200 rounded-lg">
            <div class="text-xxs uppercase tracking-wider text-gray-500 font-semibold mb-1">{{ "Cardio Strain"|trans }}</div>
            <div class="text-xl font-extrabold text-slate-800">
                {{ stress.tsb|formatNumber(1) }} <span class="text-xs font-normal text-gray-500">TSB</span>
            </div>
            <div class="text-xxs text-gray-500 mt-1">
                CTL: <span class="font-bold text-sky-600">{{ stress.ctl|formatNumber(1) }}</span> | ATL: <span class="font-bold text-purple-600">{{ stress.atl|formatNumber(1) }}</span>
            </div>
            <div class="text-xxs text-gray-400 mt-0.5">
                {{ stress.tsbPercentile|formatNumber(0) }}th %ile rank
            </div>
        </div>
    </div>

    {% if stress.subjectiveLog is not null %}
        <div class="mt-2.5 text-xxs text-gray-500 flex items-center justify-between px-1">
            <span>Soreness check: <strong class="{{ stress.subjectiveLog.sorenessScore >= 5 ? 'text-rose-600 font-bold' : (stress.subjectiveLog.sorenessScore >= 3 ? 'text-amber-600 font-bold' : 'text-emerald-600') }}">{{ stress.subjectiveLog.sorenessScore }}/10 ({{ stress.subjectiveLog.location }})</strong></span>
            <span class="text-gray-400">{{ stress.subjectiveLog.date }}</span>
        </div>
    {% else %}
        <div class="mt-2.5 text-xxs text-gray-400 text-center">
            <a href="{{ relativeUrl(path('training_stress')) }}" class="hover:underline text-blue-500">{{ "Log 10-second soreness check-in"|trans }} &rarr;</a>
        </div>
    {% endif %}
{% endautoescape %}

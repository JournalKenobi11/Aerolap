# ==============================================================================
# Aerolap / Dreeve Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.example .env.local

# Import Mode: "files" (local GPX/FIT watch folder) or "stravaApi"
IMPORT_MODE=files

# The base URL you reach the app on
APP_URL=http://localhost:8080
TZ=UTC

# Used to sign the admin session cookie (generate a secure 32-byte hex string)
APP_SECRET=change-me-to-a-secure-random-secret

# Admin panel credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2y$13$change-this-bcrypt-hash'

# Strava API Integration (Optional - for direct Strava sync)
STRAVA_CLIENT_ID=replace-me
STRAVA_CLIENT_SECRET=replace-me
STRAVA_REFRESH_TOKEN=replace-me

# AI Running Coach Integration (Optional)
AI_API_KEY=your_ai_api_key_here

# User/Group IDs for container permissions
# PUID=1000
# PGID=1000
